<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: a solid white shield with the checkmark
     knocked out of it, over the indigo background (@color/ic_launcher_background).

     Two flat shapes rather than a dark shield carrying a separate coloured
     tick: at 48dp the old version's three tones blurred into each other.
     The checkmark is painted in the background indigo so it reads as a hole
     in the shield, which survives being scaled down.

     The whole mark sits inside the 66dp adaptive-icon safe zone (21..87 in
     this 108dp viewport). The previous shield ran from y=20 to y=94 and
     poked outside it, so aggressive launcher masks could clip its tip. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,24 L76,32 L76,54 C76,71 66,81 54,84 C42,81 32,71 32,54 L32,32 Z" />
    <path
        android:fillColor="#3D4FC4"
        android:pathData="M44,52 L51,59 L66,40 L70,43 L52,66 L40,55 Z" />
</vector>
